{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truealphaspiral.org/schemas/tas.context-snapshot.v1.schema.json",
  "title": "TAS Context Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization_version",
    "namespace_id",
    "context_sequence",
    "registry_root",
    "definition_ids",
    "invariant_set_id",
    "authority_binding_hash",
    "parent_context_hash",
    "effective_epoch",
    "context_snapshot_hash"
  ],
  "properties": {
    "schema_version": {"const": "tas.context-snapshot.v1"},
    "canonicalization_version": {"const": "TAS-CJSON-1"},
    "namespace_id": {"type": "string", "minLength": 1},
    "context_sequence": {"type": "integer", "minimum": 0},
    "registry_root": {"$ref": "#/$defs/sha256"},
    "definition_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "invariant_set_id": {"$ref": "#/$defs/sha256"},
    "authority_binding_hash": {"$ref": "#/$defs/sha256"},
    "parent_context_hash": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "effective_epoch": {"type": "integer", "minimum": 0},
    "context_snapshot_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"context_sequence": {"const": 0}}},
      "then": {"properties": {"parent_context_hash": {"type": "null"}}},
      "else": {
        "properties": {
          "parent_context_hash": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
